# Leave this UNSET for the normal setup, where the backend serves both
# the website and the API from the same domain (e.g. rnrfood.com) — the
# site will just use relative paths like "/api/catalog" automatically.
#
# Only set this if your backend is hosted on a *different* domain than
# your website (e.g. website on Vercel, backend on Render):
# VITE_API_URL=https://cms.rnrfood.com
