# ─────────────────────────────────────────────────────────────
#  R&R Food CMS — Backend Environment Variables
# ─────────────────────────────────────────────────────────────
# Copy this file to .env and fill in real values before deploying.

# Port the server listens on (default: 4000)
PORT=4000

# Secret key for signing admin JWT tokens.
# IMPORTANT: Generate a long random string for production, e.g.:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# If left blank, a random secret is generated on each restart (tokens won't persist).
JWT_SECRET=

# Comma-separated list of allowed CORS origins, or * for all.
# For production set to your domain, e.g.: https://rnrfood.com
ALLOWED_ORIGIN=*

# Admin login credentials (used by seed script on first run).
# Change the password after first login via the admin panel.
ADMIN_USERNAME=rnrsnacks
ADMIN_PASSWORD=changeme123
